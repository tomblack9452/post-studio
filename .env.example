# Copy this file to .env and fill in your keys. Never commit .env.

# https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=

# Optional: override the model used for slide text
ANTHROPIC_MODEL=

# Free key from https://api.nasa.gov/ (DEMO_KEY works but is heavily rate-limited)
NASA_API_KEY=DEMO_KEY

# Optional: full path to the Claude Code CLI, used when "Claude Pro" is picked in the app.
# Only needed if `claude` isn't on your PATH.
CLAUDE_CLI_PATH=
